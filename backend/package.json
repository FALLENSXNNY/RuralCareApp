{
    "name": "ruralcare-backend",
    "version": "1.0.0",
    "description": "RuralCare backend — Node.js + Express + MongoDB Atlas + Firebase Admin token verification",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "node --watch src/server.js",
        "test": "jest --runInBand",
        "lint": "eslint src/"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^7.4.0",
        "firebase-admin": "^12.1.0",
        "mongoose": "^8.4.0"
    },
    "devDependencies": {
        "eslint": "^9.5.0",
        "jest": "^29.7.0",
        "supertest": "^7.0.0"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/tests/**/*.test.js"
        ]
    }
}