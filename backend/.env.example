# RuralCare Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.

# ── Server ────────────────────────────────────────────────────────────────
# Port the Express server listens on
PORT=3000
# development | production
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────
# MongoDB Atlas connection string
# Get from: MongoDB Atlas → Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ruralcare?retryWrites=true&w=majority

# ── Firebase Admin ────────────────────────────────────────────────────────
# Firebase project ID (used to initialize Firebase Admin)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Admin credential strategy (choose ONE):
#
# Option A (recommended for local dev):
#   Download the service account JSON from
#   Firebase Console → Project Settings → Service Accounts → Generate New Private Key
#   Save it OUTSIDE the repo (e.g. C:\secrets\ruralcare-firebase-admin.json)
#   and point this env var at it:
GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\ruralcare-firebase-admin.json
#
# Option B (recommended for production, e.g. Cloud Run / GCE):
#   Do NOT set GOOGLE_APPLICATION_CREDENTIALS.
#   Attach the service account to the runtime via the platform's
#   Application Default Credentials (ADC). No file needed.

# ── AI (Phase 7 — DO NOT USE YET) ─────────────────────────────────────────
# Gemini API key. Accessed ONLY from this backend. Never from Flutter.
GEMINI_API_KEY=