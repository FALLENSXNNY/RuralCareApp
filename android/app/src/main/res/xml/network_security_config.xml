<?xml version="1.0" encoding="utf-8"?>
<!--
  DEV-ONLY network security config.
  The RuralCare backend runs on plain HTTP during development
  (Android emulator → 10.0.2.2, iOS sim/host → localhost, physical device → LAN IP).
  Android 9+ (API 28+) blocks cleartext by default; this whitelists ONLY the
  local dev hosts so OTP verification can exchange the Firebase token with the
  backend. Production builds use HTTPS and are not affected.

  If you change AppConfig._devLanIp for a physical device, add that LAN IP here too.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator loopback to the host machine -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- iOS simulator / local dev -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Physical device on the same LAN as the dev machine -->
        <domain includeSubdomains="false">192.168.1.5</domain>
    </domain-config>
    <!-- Everything else stays cleartext-blocked -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
